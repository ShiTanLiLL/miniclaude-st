# ============================================================
# mini_claude 环境配置（复制本文件为 .env 后填写）
# 注意：离线测试（pytest）完全不需要这些；只有真实对话才需要。
# ============================================================

# 模型 API Key（必填）
# Anthropic 官方：https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxx

# 模型 ID（必填）
MODEL_ID=claude-sonnet-4-6

# 可选：接入 Anthropic 兼容厂商时填写（GLM / Kimi / DeepSeek / MiniMax 等）
# GLM:     ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic   MODEL_ID=glm-5.2
# Kimi:    ANTHROPIC_BASE_URL=https://api.moonshot.ai/anthropic        MODEL_ID=kimi-k2.7-code
# DeepSeek:ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic       MODEL_ID=deepseek-v4-pro
# ANTHROPIC_BASE_URL=
